generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Modèles métier ─────────────────

model Song {
  id        String    @id @default(cuid())
  // Unicité du titre parmi les chants NON supprimés : index unique partiel
  // "Song_title_active_key" (WHERE "deletedAt" IS NULL) créé en SQL dans la migration
  // 20261106120000_hardening — Prisma ne sait pas l'exprimer dans le schéma.
  title     String
  artist    String?
  album     String?
  year      String?
  language  String?
  tags      String[]  @default([])
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  blocks    SongBlock[]
  planItems ServiceItem[]  @relation("ServiceItemSong")
  favorites Favorite[]
  learnings SongLearning[]
  scores    SongScore[]

  @@index([title])
}

model SongBlock {
  id        String   @id @default(cuid())
  songId    String
  order     Int
  type      String
  title     String?
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  song  Song       @relation(fields: [songId], references: [id], onDelete: Cascade)
  notes SongNote[]

  @@unique([songId, order])
  @@index([songId, order])
}

model ServicePlan {
  id               String    @id @default(cuid())
  // Un seul plan NON supprimé par date : index unique partiel "ServicePlan_date_active_key"
  // (WHERE "deletedAt" IS NULL) créé en SQL dans la migration 20261106120000_hardening.
  date      DateTime
  title     String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  items ServiceItem[]

  @@index([date])
}

model ServiceItem {
  id        String   @id @default(cuid())
  planId    String
  order     Int
  kind      String
  songId    String?
  title     String?
  content   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan ServicePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  song Song?       @relation("ServiceItemSong", fields: [songId], references: [id], onDelete: SetNull)

  @@unique([planId, order])
  @@index([planId, order])
  @@index([songId])
}

// ── Partitions (PDF / images) attachées à un chant ──────────────────────────

model SongScore {
  id           String   @id @default(cuid())
  songId       String
  // FILE = PDF/PNG/JPEG (data) ; ABC = notation ABC saisie (abc) ; YAML = solfège en YAML (source) compilé en ABC (abc)
  kind         String   @default("FILE")
  // ALL, SOPRANO, ALTO, TENOR, BASSE, ACCOMPAGNEMENT
  voice        String   @default("ALL")
  position     Int      @default(0)
  filename     String
  mimeType     String
  size         Int
  // FILE : contenu soit en base (data), soit dans un stockage objet S3 compatible (storageKey)
  data         Bytes?
  storageKey   String?
  abc          String?
  // Source saisie par l'utilisateur pour les partitions "YAML" (le champ abc contient alors le résultat compilé)
  source       String?
  uploadedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@index([songId, position])
}

// ── Modèles spécifiques à l'app web ─────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  firstName    String    @default("")
  lastName     String    @default("")
  username     String    @unique @default(cuid())
  name         String    // conservé pour compatibilité — vaut "${firstName} ${lastName}"
  email        String    @unique
  passwordHash String
  role         UserRole  @default(CHANTRE)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  // Réglages d'apparence synchronisés entre appareils (JSON : { appearance, theme, updatedAt })
  uiPrefs      Json?
  // Incrémenté à chaque changement de mot de passe / désactivation : invalide les sessions (JWT) existantes
  sessionVersion Int     @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  favorites Favorite[]
  notes     SongNote[]
  learnings SongLearning[]
}

enum UserRole {
  ADMIN
  RESPONSABLE_CHANTRE
  CHANTRE
  LECTEUR
}

model Favorite {
  userId    String
  songId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@id([userId, songId])
}

model SongNote {
  id          String   @id @default(cuid())
  userId      String
  songBlockId String
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  songBlock SongBlock @relation(fields: [songBlockId], references: [id], onDelete: Cascade)
}

model SongLearning {
  userId    String
  songId    String
  status    LearningStatus @default(TO_LEARN)
  updatedAt DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@id([userId, songId])
}

enum LearningStatus {
  TO_LEARN
  IN_PROGRESS
  MASTERED
}

// ── Limitation des tentatives de connexion (partagée entre instances) ───────

model LoginThrottle {
  key         String    @id
  failures    Int       @default(0)
  windowStart DateTime
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([updatedAt])
}
