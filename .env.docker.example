# Copier ce fichier en .env.docker (ignoré par git) puis remplacer chaque CHANGE_ME.
# Utilisé par docker-compose.local.yml (test local uniquement).

POSTGRES_USER=church
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=church_presenter

# Doit reprendre les identifiants ci-dessus ; l'hôte est le service "db" du compose
DATABASE_URL=postgresql://church:CHANGE_ME@db:5432/church_presenter

# Générer avec : openssl rand -base64 32  (même valeur pour les deux)
NEXTAUTH_SECRET=CHANGE_ME
AUTH_SECRET=CHANGE_ME
NEXTAUTH_URL=http://localhost:3010

# Compte admin créé au premier démarrage
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME

# Accès direct sur le port 3010, sans reverse-proxy : l'en-tête X-Forwarded-For n'est pas digne de confiance
TRUSTED_PROXY_COUNT=0

# Stockage objet des partitions (optionnel) — ex. MinIO : S3_ENDPOINT=http://minio:9000 et S3_FORCE_PATH_STYLE=true
# S3_BUCKET=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
