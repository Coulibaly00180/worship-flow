# Copier ce fichier en .env.local et remplir les valeurs réelles
# Ne JAMAIS committer .env.local
NODE_ENV=production

DATABASE_URL="postgresql://user:pass@host:5432/worship_flow"
NEXTAUTH_SECRET="généré avec: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOSTS=true
RUN_MIGRATIONS=true

# Nombre de proxys de confiance devant l'app (IP client lue dans X-Forwarded-For en partant de la fin).
# 1 = Vercel ou un reverse-proxy (défaut) ; 0 = app exposée directement (en-tête ignoré).
TRUSTED_PROXY_COUNT=1

# Limitation des connexions : database (partagée, défaut) ou memory (local au processus)
# RATE_LIMIT_STORE=database

# Stockage objet des partitions PDF/PNG/JPEG (optionnel ; sans S3_BUCKET elles restent dans PostgreSQL)
# S3_BUCKET=worship-flow-scores
# S3_REGION=auto
# S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
