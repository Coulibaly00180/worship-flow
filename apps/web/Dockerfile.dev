# Context : racine du monorepo (docker compose -f docker-compose.local.yml up)
FROM node:26-alpine
WORKDIR /workspace

RUN for i in 1 2 3 4 5; do apk add --no-cache openssl && break || { echo "apk: nouvel essai ($i)"; sleep 5; }; done; apk info -e openssl

# Lockfile racine + manifests workspace
COPY package.json package-lock.json ./
COPY apps/web/package.json ./apps/web/

# Install dépendances workspace web (inclut devDependencies pour next dev)
RUN npm ci --workspace=apps/web --ignore-scripts

# Copie des sources dans apps/web/ — les volumes montent par-dessus en dev
COPY apps/web/prisma ./apps/web/prisma/
COPY apps/web/prisma.config.ts ./apps/web/
COPY apps/web/src ./apps/web/src/
COPY apps/web/next.config.ts apps/web/tsconfig.json apps/web/postcss.config.mjs ./apps/web/

WORKDIR /workspace/apps/web

EXPOSE 3000

# Le client Prisma est généré au démarrage : ./apps/web/src est monté par-dessus l'image en dev.
CMD ["sh", "-c", "../../node_modules/.bin/prisma generate && ../../node_modules/.bin/next dev --turbopack --hostname 0.0.0.0"]
